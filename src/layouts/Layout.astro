---
import SmoothScroll from '../components/SmoothScroll';
import LightBackground from '../components/LightBackground';
import Footer from '../components/Footer';
---

<!doctype html>
<html lang="zh">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Xing's Timeline</title>
		<style is:global>
			@font-face {
				font-family: 'Emblema One';
				src: url('/fonts/EmblemaOne-Regular.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}
			@font-face {
				font-family: 'Press Start 2P';
				src: url('/fonts/PressStart2P-Regular.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}
			/* Light Theme Scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				background: #f5f5f5;
			}
			::-webkit-scrollbar-thumb {
				background: #d4d4d8;
				border-radius: 4px;
				border: 2px solid #f5f5f5;
			}
			::-webkit-scrollbar-thumb:hover {
				background: #a1a1aa;
			}
			
			/* Selection color */
			::selection {
				background: rgba(99, 102, 241, 0.2);
				color: #4338ca;
			}
		</style>
	</head>
	<body class="bg-neutral-50 text-neutral-800 antialiased selection:bg-indigo-500/20 selection:text-indigo-700 font-sans">
		<LightBackground client:load />
		<div id="smooth-wrapper">
			<div id="smooth-content" class="relative z-10">
				<main class="relative z-20">
					<slot />
				</main>
				<Footer client:load />
			</div>
		</div>
		<SmoothScroll client:load />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	#smooth-wrapper {
		height: 100%;
	}
</style>
