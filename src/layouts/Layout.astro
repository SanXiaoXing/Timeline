---
import '../styles/typography.css';
import LightBackground from '../components/LightBackground';
import CardNav from '../components/CardNav';
import Footer from '../components/Footer';

const navItems = [
  {
    label: "成就",
    links: [
      { label: "成就墙", ariaLabel: "前往成就页面", href: "/achievements" }
    ]
  },
  {
    label: "项目",
    links: [
      { label: "项目日志", ariaLabel: "前往项目页面", href: "/projects" },
      { label: "Xing's Quotes", ariaLabel: "前往星语页面", href: "/xing" }
    ]
  },
  {
    label: "联系",
    links: [
      { label: "Email", ariaLabel: "发送邮件", href: "mailto:sanxiaoxing@qq.com" },
      { label: "GitHub", ariaLabel: "GitHub", href: "https://github.com/SanXiaoXing" }
    ]
  }
];
---

<!doctype html>
<html lang="zh">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Xing's Timeline</title>
		<style is:global>
			/* --- Fonts --- */
			@font-face {
				font-family: 'Instrument Serif';
				src: url('/fonts/InstrumentSerif-Regular.woff2') format('woff2');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}
			@font-face {
				font-family: 'Instrument Serif';
				src: url('/fonts/InstrumentSerif-Italic.woff2') format('woff2');
				font-weight: normal;
				font-style: italic;
				font-display: swap;
			}
			/*
			 * Brand mark — Emblema One. Single weight (Regular) TTF.
			 * Reserved for the SanXiaoXing wordmark only. Emblema One is a
			 * strong decorative display face; do NOT use it for long passages.
			 * Fallback chain: Emblema One → Instrument Serif (similar serif
			 * silhouette) → Noto Serif SC (CJK serif) → generic serif.
			 */
			@font-face {
				font-family: 'Emblema One';
				src: url('/fonts/EmblemaOne-Regular.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
				unicode-range: U+0041-005A, U+0061-007A, U+0030-0039; /* ASCII letters/digits only */
			}
			@font-face {
				font-family: 'DM Sans';
				src: url('/fonts/DMSans-Regular.woff2') format('woff2');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}
			@font-face {
				font-family: 'DM Sans';
				src: url('/fonts/DMSans-Medium.woff2') format('woff2');
				font-weight: 500;
				font-style: normal;
				font-display: swap;
			}
			@font-face {
				font-family: 'JetBrains Mono';
				src: url('/fonts/JetBrainsMono-Regular.woff2') format('woff2');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}

			/* --- Base --- */
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html, body {
				margin: 0;
				padding: 0;
				width: 100%;
				background-color: #F6F2EB;
				color: #2C3639;
				font-family: 'DM Sans', 'Noto Sans SC', sans-serif;
				line-height: 1.8;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
				font-feature-settings: 'kern' 1, 'liga' 1, 'calt' 1, 'onum' 1;
				font-kerning: normal;
				font-variant-ligatures: common-ligatures contextual;
			}

			/* --- Display type: optical sizing + Instrument Serif's stylistic set --- */
			.font-display {
				font-feature-settings: 'kern' 1, 'liga' 1, 'calt' 1, 'onum' 1, 'ss01' 1;
				font-optical-sizing: auto;
				font-variant-numeric: oldstyle-nums proportional-nums;
			}

			/* --- Mono copy: tabular figures for stable number columns --- */
			.font-mono {
				font-feature-settings: 'kern' 0, 'liga' 0, 'calt' 0, 'tnum' 1, 'zero' 1;
				font-variant-numeric: tabular-nums slashed-zero;
			}

			/* --- Scrollbar (paper theme) --- */
			::-webkit-scrollbar { width: 6px; }
			::-webkit-scrollbar-track { background: #F6F2EB; }
			::-webkit-scrollbar-thumb { background: #D45D4A; }
			::-webkit-scrollbar-thumb:hover { background: #b84a3a; }

			/* --- Selection --- */
			::selection {
				background: rgba(212, 93, 74, 0.2);
				color: #2C3639;
			}

			/* --- Reduced motion --- */
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</head>
	<body class="font-body">
		<LightBackground client:load />
		<CardNav
			client:load
			logoText="SanXiaoXing"
			items={navItems}
		/>
		<main class="relative z-10">
			<slot />
		</main>
		<Footer client:load />
	</body>
</html>