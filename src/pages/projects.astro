---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { ProjectStatus, Project } from '../contents/projects/types';
import { projectStatusLabel } from '../contents/projects/types';
import type { AchievementCategory } from '../contents/achievements';
import { achievementCategoryLabels } from '../contents/achievements';

const projectsCollection = await getCollection('projects');
const projects = projectsCollection.map(p => ({
  slug: p.id,
  ...p.data
})) as Project[];

const statusTheme: Record<string, { border: string; text: string; bg: string; shadow: string }> = {
  in_progress: { 
    border: 'border-emerald-400/40', 
    text: 'text-emerald-600', 
    bg: 'bg-emerald-500/10',
    shadow: 'shadow-emerald-100/50'
  },
  paused: { 
    border: 'border-amber-400/40', 
    text: 'text-amber-600', 
    bg: 'bg-amber-500/10',
    shadow: 'shadow-amber-100/50'
  },
  completed: { 
    border: 'border-sky-400/40', 
    text: 'text-sky-600', 
    bg: 'bg-sky-500/10',
    shadow: 'shadow-sky-100/50'
  }
};
---

<Layout>
  <div class="relative min-h-screen overflow-hidden">
    {/* Light Theme Background */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-100/30 via-transparent to-transparent pointer-events-none z-0"></div>

    <div class="pt-32 px-6 relative z-10 max-w-5xl mx-auto">
      {/* Header Section */}
      <section class="mb-20 text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-neutral-800 tracking-tight mb-6">
          副本 <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-cyan-500">日志</span>
        </h1>
        <p class="text-neutral-500 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed">
          追踪个人数字作品的开发进度与关键里程碑。
        </p>
      </section>

      <section class="mb-20">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/60 border border-neutral-200/50 backdrop-blur-sm mb-4 shadow-sm">
              <div class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></div>
              <span class="text-xs font-medium text-neutral-600 uppercase tracking-wider">目录</span>
            </div>
            <h2 class="text-2xl font-semibold text-neutral-800">
              选择一个副本查看进度
            </h2>
          </div>
          <div class="flex items-center gap-4">
            <a
              href="/"
              class="group relative inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/60 border border-neutral-200/50 text-neutral-600 hover:text-indigo-600 hover:border-indigo-400/30 hover:bg-white transition-all duration-500 overflow-hidden shadow-sm hover:shadow-lg hover:shadow-indigo-100/50"
              data-magnetic
            >
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1 relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span class="text-sm font-medium tracking-wide relative z-10">返回首页</span>
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {projects.map((p) => {
            const theme = statusTheme[p.status] ?? statusTheme.in_progress;
            return (
              <a
                href={`/projects/${p.slug}`}
                class="group relative flex flex-col justify-between rounded-2xl bg-white/70 border border-neutral-200/50 p-6 md:p-8 hover:bg-white/90 transition-all duration-500 overflow-hidden shadow-lg shadow-neutral-100/50 hover:shadow-xl hover:shadow-indigo-100/30"
                data-magnetic
              >
                {/* Hover Gradient Effect */}
                <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                
                <div class="relative z-10">
                  <div class="flex items-start justify-between gap-4 mb-6">
                    <h3 class="text-xl md:text-2xl font-semibold text-neutral-800 group-hover:text-indigo-600 transition-colors duration-300">
                      {p.name}
                    </h3>
                    <span
                      class={`shrink-0 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium border ${theme.bg} ${theme.text} ${theme.border}`}
                    >
                      {projectStatusLabel[p.status]}
                    </span>
                  </div>

                  <p class="text-neutral-500 text-sm leading-relaxed mb-6 line-clamp-2">
                    当前阶段：<span class="text-neutral-700 font-medium">{p.currentStage}</span>
                  </p>

                  <div class="flex flex-wrap gap-2 mb-8">
                    {p.achievementTags.map((t) => (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-neutral-100/80 text-neutral-600 border border-neutral-200/50">
                        {achievementCategoryLabels[t as AchievementCategory]}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="relative z-10 flex items-center justify-between mt-auto pt-6 border-t border-neutral-200/30">
                  <div class="flex-1 mr-6">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-xs font-medium text-neutral-400 uppercase tracking-wider">完成度</span>
                      <span class="text-xs font-medium text-neutral-700">{p.progressPct}%</span>
                    </div>
                    <div class="h-1.5 w-full bg-neutral-200/50 rounded-full overflow-hidden">
                      <div 
                        class="h-full bg-gradient-to-r from-indigo-500 to-cyan-400 rounded-full transition-all duration-1000 ease-out group-hover:shadow-[0_0_10px_rgba(99,102,241,0.3)]"
                        style={{ width: `${p.progressPct}%` }}
                      ></div>
                    </div>
                  </div>
                  <div class="shrink-0 group/btn relative inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/80 border border-neutral-200/50 text-indigo-600 hover:text-indigo-700 hover:border-indigo-400/30 hover:bg-white transition-all duration-500 overflow-hidden shadow-sm hover:shadow-md">
                    <span class="text-sm font-medium tracking-wide relative z-10">查看详情</span>
                    <svg class="w-4 h-4 relative z-10 transform group-hover/btn:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    </div>
  </div>
</Layout>
