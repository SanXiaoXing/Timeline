---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BackButton from '../components/BackButton';
import type { Project } from '../contents/projects/types';
import { projectStatusLabel } from '../contents/projects/types';
import type { AchievementCategory } from '../contents/achievements';
import { achievementCategoryLabels } from '../contents/achievements';

const projectsCollection = await getCollection('projects');
const projects = projectsCollection.map(p => ({
  slug: p.id,
  ...p.data
})) as Project[];

const statusTheme: Record<string, { border: string; text: string; bg: string }> = {
  in_progress: { border: '#059669', text: '#059669', bg: 'rgba(16,185,129,0.08)' },
  paused:      { border: '#d97706', text: '#d97706', bg: 'rgba(245,158,11,0.08)' },
  completed:   { border: '#0284c7', text: '#0284c7', bg: 'rgba(14,165,233,0.08)' }
};
---

<Layout>
  <div class="relative min-h-screen">
    <div class="pt-32 px-6 md:px-12 relative z-10 max-w-content mx-auto">
      {/* Header */}
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-0">
          <div class="md:col-span-7">
            <p class="font-mono text-xs tracking-[0.2em] uppercase text-muted mb-4">Projects</p>
            <h1 class="font-display text-4xl md:text-5xl text-primary font-normal leading-[1.15]">
              副本日志
            </h1>
            <p class="mt-4 text-muted text-base leading-relaxed max-w-[50ch]">
              追踪个人数字作品的开发进度与关键里程碑。
            </p>
          </div>
          <div class="md:col-span-3 md:col-start-10 mt-6 md:mt-0 flex items-end">
            <BackButton href="/">返回首页</BackButton>
          </div>
        </div>
      </section>

      <section class="mb-20">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {projects.map((p, idx) => {
            const theme = statusTheme[p.status] ?? statusTheme.in_progress;
            return (
              <a
                href={`/projects/${p.slug}`}
                class="group relative flex flex-col justify-between p-6 md:p-8 overflow-hidden transition-all duration-300"
                style={{
                  borderTop: `2px solid ${theme.border}`,
                  backgroundColor: 'transparent',
                  animation: `cardEnter 0.5s ease-out ${idx * 0.08}s forwards`,
                  opacity: 0,
                  transform: 'translateY(20px)',
                }}
              >
                <!-- Grain texture overlay -->
                <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.02]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E&quot;); background-repeat: repeat; background-size: 128px 128px;"></div>

                <!-- Hover background -->
                <div class="absolute inset-0 z-[1] transition-opacity duration-300 opacity-0 group-hover:opacity-100 bg-card"></div>

                <div class="relative z-10">
                  <!-- Status folio marker -->
                  <div class="flex items-center justify-between mb-6">
                    <span
                      class="font-mono text-[10px] font-bold uppercase tracking-[0.15em] px-2 py-0.5"
                      style={{ color: theme.text, backgroundColor: theme.bg, borderBottom: `1px solid ${theme.border}` }}
                    >
                      {projectStatusLabel[p.status]}
                    </span>
                    <span class="font-mono text-[10px] text-muted tracking-wider uppercase">
                      No. {String(idx + 1).padStart(2, '0')}
                    </span>
                  </div>

                  <h3 class="font-display text-2xl md:text-3xl text-primary font-normal leading-tight group-hover:text-accent transition-colors duration-300 mb-4">
                    {p.name}
                  </h3>

                  <p class="text-muted text-sm leading-relaxed mb-6 line-clamp-2 max-w-[40ch]">
                    当前阶段：<span class="text-primary font-medium">{p.currentStage}</span>
                  </p>

                  <div class="flex flex-wrap gap-2 mb-8">
                    {p.achievementTags.map((t) => (
                      <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium text-muted" style={{ borderBottom: '1px solid #E5DFD6' }}>
                        {achievementCategoryLabels[t as AchievementCategory]}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="relative z-10 flex items-center justify-between mt-auto pt-6" style={{ borderTop: '1px solid #E5DFD6' }}>
                  <div class="flex-1 mr-6">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-xs text-muted uppercase tracking-wider">完成度</span>
                      <span class="text-xs font-mono text-primary tabular-nums">{p.progressPct}%</span>
                    </div>
                    <div class="h-[2px] w-full overflow-hidden" style={{ backgroundColor: '#E5DFD6' }}>
                      <div
                        class="h-full transition-all duration-700 ease-out"
                        style={{ width: `${p.progressPct}%`, backgroundColor: theme.border }}
                      ></div>
                    </div>
                  </div>
                  <div class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 text-sm text-muted group-hover:text-link transition-colors duration-200">
                    <span>查看详情</span>
                    <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <style>
        @keyframes cardEnter {
          to { opacity: 1; transform: translateY(0); }
        }
      </style>
    </div>
  </div>
</Layout>