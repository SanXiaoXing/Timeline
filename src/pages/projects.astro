---
import Layout from '../layouts/Layout.astro';
import CardNav from '../components/CardNav';
import ProjectQuestLog from '../components/ProjectQuestLog';
import { projects, projectStatusLabel } from '../contents/projects';

const statusTheme: Record<string, { border: string; text: string; bg: string }> = {
  in_progress: { border: '#22C55E', text: '#86EFAC', bg: 'rgba(34,197,94,0.10)' },
  paused: { border: '#F59E0B', text: '#FCD34D', bg: 'rgba(245,158,11,0.10)' },
  completed: { border: '#38BDF8', text: '#7DD3FC', bg: 'rgba(56,189,248,0.10)' }
};

const items = [
  {
    label: "Home",
    bgColor: "#0D0716",
    textColor: "#fff",
    links: [
      { label: "Back to Home", ariaLabel: "Go Home", href: "/" }
    ]
  },
  {
    label: "Projects",
    bgColor: "#170D27",
    textColor: "#fff",
    links: [
      { label: "Featured", ariaLabel: "Featured Projects", href: "#" },
      { label: "Case Studies", ariaLabel: "Project Case Studies", href: "#" }
    ]
  },
  {
    label: "Contact",
    bgColor: "#271E37",
    textColor: "#fff",
    links: [
      { label: "Email", ariaLabel: "Email us", href: "#" },
      { label: "GitHub", ariaLabel: "GitHub Profile", href: "#" }
    ]
  }
];
---

<Layout>
  <div class="relative min-h-screen bg-[#0F0F23] overflow-hidden selection:bg-[#F43F5E] selection:text-white">
    {/* Background Grid */}
    <div class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.1)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_20%,black_40%,transparent_100%)] pointer-events-none z-0"></div>

    <div class="pt-32 px-4 relative z-10 max-w-7xl mx-auto">
      {/* Header Section */}
      <section class="mb-16 text-center">
        <h1 class="text-3xl md:text-5xl font-bold text-[#E2E8F0] font-['Press_Start_2P'] mb-6 drop-shadow-[4px_4px_0px_#7C3AED]">
          PROJECT LOGS
        </h1>
        <p class="text-[#94A3B8] font-['VT323'] text-xl md:text-2xl max-w-2xl mx-auto leading-relaxed">
          Tracking the development progress and milestones of my digital creations.
          <br/>
          <span class="text-[#F43F5E]">> System Status: ONLINE</span>
        </p>
      </section>

      <section class="mb-14">
        <div class="flex items-end justify-between gap-6">
          <div>
            <div class="inline-flex items-center gap-2 border-2 border-[#7C3AED] bg-[#0B0B1A] px-3 py-2 shadow-[4px_4px_0px_#7C3AED]">
              <span class="font-['PressStart2P'] text-[12px] text-[#A78BFA]">DUNGEONS</span>
              <span class="text-[#94A3B8] text-[12px]">项目副本列表</span>
            </div>
            <div class="mt-4 text-[#E2E8F0] text-xl md:text-2xl font-bold">
              选择一个项目进入进度界面
            </div>
          </div>
          <a
            href="/projects/timeline"
            class="hidden md:inline-flex items-center justify-center border-2 border-[#F43F5E] bg-[#0B0B1A] px-4 py-3 text-[#E2E8F0] shadow-[4px_4px_0px_rgba(244,63,94,0.55)] transition-transform duration-200 hover:-translate-y-[2px]"
          >
            <span class="font-['PressStart2P'] text-[12px]">进入主线</span>
          </a>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          {projects.map((p) => {
            const theme = statusTheme[p.status] ?? statusTheme.in_progress;
            return (
              <a
                href={`/projects/${p.slug}`}
                class="group border-4 bg-[#0B0B1A] p-6 shadow-[8px_8px_0px_rgba(124,58,237,0.55)] transition-transform duration-200 hover:-translate-y-[2px]"
                style={{ borderColor: theme.border }}
              >
                <div class="flex items-start justify-between gap-6">
                  <div class="min-w-0">
                    <div class="text-[#E2E8F0] text-lg md:text-xl font-bold truncate">
                      <span class="font-['PressStart2P']">{p.name}</span>
                    </div>
                    <div class="mt-3 text-[#94A3B8] text-sm leading-relaxed truncate">
                      当前剧情：<span class="text-[#E2E8F0]">{p.currentStage}</span>
                    </div>
                  </div>
                  <div class="shrink-0 grid gap-3 text-right">
                    <span
                      class="inline-flex items-center justify-center border-2 px-3 py-2 shadow-[4px_4px_0px_rgba(51,65,85,0.75)]"
                      style={{ borderColor: theme.border, color: theme.text, backgroundColor: theme.bg }}
                    >
                      <span class="font-['PressStart2P'] text-[11px]">{projectStatusLabel[p.status]}</span>
                    </span>
                    <span class="border-2 border-[#334155] bg-black/20 px-3 py-2 text-[#E2E8F0] shadow-[4px_4px_0px_rgba(51,65,85,0.65)]">
                      <span class="font-['PressStart2P'] text-[12px]">{p.progressPct}%</span>
                    </span>
                  </div>
                </div>

                <div class="mt-5 flex items-center justify-between border-2 border-[#334155] bg-black/10 px-4 py-3 shadow-[4px_4px_0px_rgba(51,65,85,0.55)]">
                  <span class="text-[#94A3B8] text-sm">进入副本</span>
                  <span class="font-['PressStart2P'] text-[12px] text-[#FCA5A5]">OPEN</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    </div>
  </div>
</Layout>
