---
import CardNav from '../components/CardNav';
import RotatingText from '../components/RotatingText';
import TimeProgress from '../components/TimeProgress';
import AchievementsCarousel from '../components/AchievementsCarousel';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allAchievementsEntries = await getCollection('achievements');
const achievements = allAchievementsEntries.flatMap(entry => entry.data.list);

const items = [
  {
    label: "Awards",
    bgColor: "rgba(24, 24, 27, 0.5)", // zinc-900/50
    textColor: "#f4f4f5", // zinc-100
    links: [
      { label: "Trophy Room", ariaLabel: "Go to Achievements", href: "/achievements" }
    ]
  },
  {
    label: "Projects",
    bgColor: "rgba(24, 24, 27, 0.5)",
    textColor: "#f4f4f5",
    links: [
      { label: "Project Logs", ariaLabel: "Go to Projects", href: "/projects" }
    ]
  },
  {
    label: "Contact",
    bgColor: "rgba(24, 24, 27, 0.5)",
    textColor: "#f4f4f5",
    links: [
      { label: "Email", ariaLabel: "Email us", href: "mailto:sanxiaoxing@qq.com" },
      { label: "Github", ariaLabel: "Github", href: "https://github.com/SanXiaoXing" }
    ]
  }
];
---

<Layout>
  <div class="relative min-h-screen overflow-hidden selection:bg-indigo-500/30 selection:text-indigo-200">
    {/* Refined Background Gradient */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 pointer-events-none z-0"></div>
    <div class="absolute inset-0 pointer-events-none z-0 opacity-20">
      <div class="absolute -top-40 left-1/2 h-[560px] w-[560px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(99,102,241,0.4)_0%,rgba(99,102,241,0)_62%)] blur-3xl"></div>
    </div>
    
    <CardNav
      client:load
      logoText="SanXiaoXing"
      logoFont="'Emblema One', cursive"
      logoAlt="SanXiaoXing Logo"
      items={items}
      baseColor="transparent"
      menuColor="#a1a1aa"
      buttonBgColor="#4f46e5"
      buttonTextColor="#fff"
      ease="power3.out"
      className="border border-white/10 rounded-2xl bg-zinc-900/30 backdrop-blur-md"
    />
    
    <div class="pt-32 px-4 md:px-6 relative z-10 max-w-6xl mx-auto">
      <section class="py-12 md:py-20 text-center">
        <h1 class="text-balance text-4xl font-bold tracking-tight text-zinc-100 md:text-7xl">
          记录我的
          <span class="ml-2 inline-flex h-[1.15em] overflow-hidden align-baseline">
            <RotatingText
              client:load
              texts={['灵感', '日常', '成长', '项目', '人生片段']}
              rotationInterval={2200}
              staggerDuration={0.03}
              staggerFrom="first"
              mainClassName="inline-flex font-bold text-indigo-400"
              splitLevelClassName="inline-flex"
              elementLevelClassName="will-change-transform"
              style={{ fontFamily: "'Emblema One', cursive" }}
            />
          </span>
        </h1>
      </section>

      <TimeProgress client:load />

      <AchievementsCarousel client:load initialAchievements={achievements} />
	
    </div>
  </div>
</Layout>
