---
import CardNav from '../components/CardNav';
import RotatingText from '../components/RotatingText';
import TimeProgress from '../components/TimeProgress';
import AchievementsCarousel from '../components/AchievementsCarousel';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allAchievementsEntries = await getCollection('achievements');
const achievements = allAchievementsEntries.flatMap((entry: { data: { list: unknown[] } }) => entry.data.list);

const items = [
  {
    label: "Awards",
    bgColor: "rgba(255, 255, 255, 0.7)",
    textColor: "#27272a",
    links: [
      { label: "Trophy Room", ariaLabel: "Go to Achievements", href: "/achievements" }
    ]
  },
  {
    label: "Projects",
    bgColor: "rgba(255, 255, 255, 0.7)",
    textColor: "#27272a",
    links: [
      { label: "Project Logs", ariaLabel: "Go to Projects", href: "/projects" },
      { label: "Xing's Quotes", ariaLabel: "Go to Quotes", href: "/xing" }
    ]
  },
  {
    label: "Contact",
    bgColor: "rgba(255, 255, 255, 0.7)",
    textColor: "#27272a",
    links: [
      { label: "Email", ariaLabel: "Email us", href: "mailto:sanxiaoxing@qq.com" },
      { label: "Github", ariaLabel: "Github", href: "https://github.com/SanXiaoXing" }
    ]
  }
];
---

<Layout>
  <div class="relative min-h-screen overflow-hidden">
    {/* Subtle gradient overlay */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-100/50 via-transparent to-transparent pointer-events-none z-0"></div>
    
    <CardNav
      client:load
      logoText="SanXiaoXing"
      logoFont="'Emblema One', cursive"
      logoAlt="SanXiaoXing Logo"
      items={items}
      baseColor="rgba(255, 255, 255, 0.8)"
      menuColor="#52525b"
      buttonBgColor="#6366f1"
      buttonTextColor="#fff"
      ease="power3.out"
      className="border border-neutral-200/50 rounded-2xl bg-white/70 backdrop-blur-xl shadow-lg shadow-neutral-200/50"
    />
    
    <div class="pt-32 px-4 md:px-6 relative z-10 max-w-6xl mx-auto">
      <section class="py-12 md:py-20 text-center">
        <h1 class="text-balance text-4xl font-bold tracking-tight text-neutral-800 md:text-7xl">
          记录我的
          <span class="ml-2 inline-flex h-[1.15em] overflow-hidden align-baseline">
            <RotatingText
              client:load
              texts={['灵感', '日常', '成长', '项目', '人生片段']}
              rotationInterval={2200}
              staggerDuration={0.03}
              staggerFrom="first"
              mainClassName="inline-flex font-bold text-indigo-500"
              splitLevelClassName="inline-flex"
              elementLevelClassName="will-change-transform"
              style={{ fontFamily: "'Emblema One', cursive" }}
            />
          </span>
        </h1>
      </section>

      <TimeProgress client:load />

      <AchievementsCarousel client:load initialAchievements={achievements} />
    
    </div>
  </div>
</Layout>
