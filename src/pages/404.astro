---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="noise"></div>
  <div class="overlay"></div>
  <div class="terminal">
    <h1>Error <span class="errorcode">404</span></h1>
    <p class="output">The page you are looking for might have been removed, had its name changed or is temporarily unavailable.</p>
    <p class="output">Please try to <a href="#" id="go-back">go back</a> or <a href="/">return to the homepage</a>.</p>
    <p class="output">Good luck.</p>
  </div>
  <style is:global>
    html { min-height: 100%; }
    body {
      box-sizing: border-box;
      height: 100%;
      background-color: #282a36;
      background-image: radial-gradient(#3a3c4e, #1e1f29), url("https://media.giphy.com/media/oEI9uBYSzLpBK/giphy.gif");
      background-repeat: no-repeat;
      background-size: cover;
      font-family: Helvetica, sans-serif;
      font-size: 1.5rem;
      color: #f8f8f2;
      text-shadow: none;
    }
    .terminal h1,
    .output,
    .errorcode {
      font-family: "PressStart2P", Helvetica, sans-serif;
    }
    .noise {
      pointer-events: none;
      position: absolute;
      width: 100%;
      height: 100%;
      background-image: url("https://media.giphy.com/media/oEI9uBYSzLpBK/giphy.gif");
      background-repeat: no-repeat;
      background-size: cover;
      z-index: -1;
      opacity: 0.02;
    }
    .overlay {
      pointer-events: none;
      position: absolute;
      width: 100%;
      height: 100%;
      background: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0.3) 50%, rgba(0, 0, 0, 0) 100%);
      background-size: auto 4px;
      z-index: 1;
    }
    .overlay::before {
      content: "";
      pointer-events: none;
      position: absolute;
      display: block;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      background-image: linear-gradient(0deg, transparent 0%, rgba(189, 147, 249, 0.2) 2%, rgba(189, 147, 249, 0.8) 3%, rgba(189, 147, 249, 0.2) 3%, transparent 100%);
      background-repeat: no-repeat;
      animation: scan 7.5s linear 0s infinite;
    }
    @keyframes scan {
      0% { background-position: 0 -100vh; }
      35%, 100% { background-position: 0 100vh; }
    }
    .terminal {
      box-sizing: inherit;
      position: absolute;
      height: 100%;
      width: 1000px;
      max-width: 100%;
      padding: 4rem;
      text-transform: uppercase;
    }
    .output {
      color: #f8f8f2;
      text-shadow: none;
      transition: color 0.2s ease, text-shadow 0.2s ease;
    }
    .output:hover { text-shadow: none; }
    .output::before { content: "> "; }
    .output a { color: #bd93f9; text-decoration: none; transition: color 0.2s ease, text-shadow 0.2s ease; }
    .output a:hover { color: #bd93f9; text-shadow: 0 0 6px rgba(189, 147, 249, 0.8), 0 0 12px rgba(189, 147, 249, 0.6), 0 0 18px rgba(189, 147, 249, 0.4); }
    .output a::before { content: "["; }
    .output a::after { content: "]"; }
    .terminal h1 {
      margin: 0 0 2.5rem 0;
      font-size: clamp(3rem, 6vw, 5rem);
      line-height: 1.05;
      color: #f8f8f2;
      text-shadow: 0 0 8px rgba(189, 147, 249, 0.8), 0 0 16px rgba(189, 147, 249, 0.6), 0 0 24px rgba(189, 147, 249, 0.4);
    }
    .errorcode { color: #f8f8f2; text-shadow: 0 0 10px rgba(189, 147, 249, 0.9), 0 0 20px rgba(189, 147, 249, 0.6), 0 0 30px rgba(189, 147, 249, 0.4); }
  </style>
  <script>
    const el = document.getElementById('go-back');
    if (el) {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        if (history.length > 1) {
          history.back();
        } else {
          window.location.href = '/';
        }
      });
    }
  </script>
</Layout>
