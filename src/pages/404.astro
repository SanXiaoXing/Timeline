---
import Layout from '../layouts/Layout.astro';
import BackButton from '../components/BackButton';
---

<Layout>
  <div class="relative min-h-screen flex items-center justify-center">
    <div class="p-8 text-center">
      <p class="font-mono text-xs tracking-[0.2em] uppercase text-muted mb-6">错误</p>
      
      <h1 class="font-display text-8xl md:text-9xl leading-none text-primary mb-6">
        404
      </h1>
      
      <p class="text-muted text-base md:text-lg leading-relaxed max-w-md mx-auto mb-10">
        你寻找的页面已被移除、更名或暂时不可用。
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <BackButton client:load>返回上一页</BackButton>
        <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-sm text-paper" style="background-color: #2C3639;">
          返回首页
        </a>
      </div>
    </div>
  </div>
  
</Layout>