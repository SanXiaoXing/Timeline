---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="relative min-h-screen overflow-hidden flex items-center justify-center selection:bg-indigo-500/30 selection:text-indigo-200">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-zinc-950 to-zinc-950 pointer-events-none z-0"></div>
    <div class="absolute inset-0 pointer-events-none z-0 opacity-20">
      <div class="absolute -top-40 left-1/2 h-[560px] w-[560px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(99,102,241,0.4)_0%,rgba(99,102,241,0)_62%)] blur-3xl"></div>
    </div>
    
    <div class="relative z-10 p-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-6">
        <div class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></div>
        <span class="text-xs font-medium text-zinc-300 uppercase tracking-wider">System Error</span>
      </div>
      
      <h1 class="text-7xl md:text-9xl font-bold tracking-tight text-zinc-100 mb-6 drop-shadow-2xl">
        <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-400 to-cyan-400">404</span>
      </h1>
      
      <p class="text-zinc-400 text-lg md:text-xl font-light leading-relaxed max-w-lg mx-auto mb-10">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <button id="go-back" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-medium text-zinc-900 bg-zinc-100 hover:bg-white transition-all duration-300">
          Go Back
        </button>
        <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-medium text-zinc-300 bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white transition-all duration-300 backdrop-blur-sm">
          Return to Homepage
        </a>
      </div>
    </div>
  </div>
  
  <script>
    const el = document.getElementById('go-back');
    if (el) {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        if (history.length > 1) {
          history.back();
        } else {
          window.location.href = '/';
        }
      });
    }
  </script>
</Layout>
