---
import Layout from '../layouts/Layout.astro';
import AchievementsWall from '../components/AchievementsWall';
import { getCollection } from 'astro:content';

const allAchievementsEntries = await getCollection('achievements');
const achievements = allAchievementsEntries.flatMap(entry => entry.data.list);
---

<Layout>
  <div class="relative min-h-screen overflow-hidden">
    {/* Light Theme Background */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-100/30 via-transparent to-transparent pointer-events-none z-0"></div>
    <div class="absolute inset-0 pointer-events-none z-0 opacity-30">
      <div class="absolute -top-32 left-1/2 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(99,102,241,0.2)_0%,transparent_62%)] blur-3xl"></div>
      <div class="absolute -bottom-40 left-12 h-[520px] w-[520px] rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.15)_0%,transparent_62%)] blur-3xl"></div>
    </div>

    <div class="relative z-10">
      <AchievementsWall client:load initialAchievements={achievements} />
    </div>
  </div>
</Layout>
