---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectProgressHUD from '../../components/ProjectProgressHUD';
import type { Project } from '../../contents/projects/types';
import { marked } from 'marked';

export async function getStaticPaths() {
  const projectsCollection = await getCollection('projects');
  return projectsCollection.map((project: { id: string; data: Record<string, unknown>; body?: string }) => ({
    params: { slug: project.id },
    props: { project: { slug: project.id, ...project.data } as Project, body: project.body }
  }));
}

const { project, body } = Astro.props;
const contentHtml = body ? marked.parse(body) : '';
---

<Layout>
  <div class="relative min-h-screen">
    <div class="relative z-10">
      <ProjectProgressHUD client:load project={project} />
      
      {body && (
        <section class="max-w-content mx-auto px-4 md:px-8 pb-32">
          {/* Magazine section divider */}
          <div class="flex items-center gap-6 mb-16 reveal-section">
            <div class="flex-1 h-px" style="background: #E5DFD6"></div>
            <span class="font-mono text-xs tracking-[0.2em] uppercase text-accent shrink-0">Overview</span>
            <div class="flex-1 h-px" style="background: #E5DFD6"></div>
          </div>

          <div class="project-content mx-auto reveal-content" style="max-width: 720px">
            <div set:html={contentHtml} />
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<style is:global>
  .project-content {
    color: #7A7A72;
    line-height: 1.85;
    font-size: 1.0625rem;
  }

  .project-content p {
    margin-bottom: 2rem;
    color: #7A7A72;
  }

  .project-content p:last-child {
    margin-bottom: 0;
  }

  .project-content h2 {
    font-family: 'Instrument Serif', 'Noto Serif SC', serif;
    font-size: 1.75rem;
    font-weight: normal;
    color: #2C3639;
    margin-top: 5rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .project-content h3 {
    font-size: 1.125rem;
    font-weight: 500;
    color: #2C3639;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .project-content ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 2rem;
  }

  .project-content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: #7A7A72;
  }

  .project-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 5px;
    height: 5px;
    background: #D45D4A;
  }

  .project-content strong {
    color: #2C3639;
    font-weight: 500;
  }

  .project-content a {
    color: #4A6B5F;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #4A6B5F;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .project-content a:hover {
    text-decoration-color: #2C3639;
  }

  .project-content > p:first-of-type {
    font-size: 1.25rem;
    color: #2C3639;
    line-height: 1.75;
    margin-bottom: 3.5rem;
  }

  .project-content hr {
    border: none;
    height: 1px;
    background: #E5DFD6;
    margin: 4rem 0;
  }

  .project-content blockquote {
    border-left: 2px solid #D45D4A;
    padding-left: 1.5rem;
    margin: 2.5rem 0;
    color: #7A7A72;
    font-style: normal;
  }

  .project-content code {
    background: #F0EBE3;
    color: #2C3639;
    padding: 0.2rem 0.4rem;
    font-size: 0.9em;
    font-family: 'JetBrains Mono', monospace;
  }

  @media (max-width: 768px) {
    .project-content {
      font-size: 1rem;
    }

    .project-content h2 {
      font-size: 1.5rem;
      margin-top: 3.5rem;
    }

    .project-content > p:first-of-type {
      font-size: 1.125rem;
    }
  }

  /* Scroll reveal animations */
  .reveal-section,
  .reveal-content {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  .reveal-section.visible,
  .reveal-content.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-content {
    transition-delay: 0.15s;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-section,
    .reveal-content {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Scroll-triggered entrance animation for overview section
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal-section, .reveal-content').forEach((el) => {
    observer.observe(el);
  });
</script>