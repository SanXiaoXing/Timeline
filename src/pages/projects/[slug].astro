---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectProgressHUD from '../../components/ProjectProgressHUD';
import type { Project } from '../../contents/projects/types';
import { marked } from 'marked';

export async function getStaticPaths() {
  const projectsCollection = await getCollection('projects');
  return projectsCollection.map((project: { id: string; data: Record<string, unknown>; body?: string }) => ({
    params: { slug: project.id },
    props: { project: { slug: project.id, ...project.data } as Project, body: project.body }
  }));
}

const { project, body } = Astro.props;
const contentHtml = body ? marked.parse(body) : '';
---

<Layout>
  <div class="relative min-h-screen overflow-hidden">
    {/* Light Theme Background */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-100/30 via-transparent to-transparent pointer-events-none z-0"></div>
    <div class="absolute inset-0 pointer-events-none z-0 opacity-30">
      <div class="absolute -top-40 left-1/2 h-[560px] w-[560px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(99,102,241,0.2)_0%,transparent_62%)] blur-3xl"></div>
      <div class="absolute -bottom-48 left-12 h-[560px] w-[560px] rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.15)_0%,transparent_62%)] blur-3xl"></div>
    </div>

    <div class="relative z-10">
      <ProjectProgressHUD client:load project={project} />
      
      {/* Project Content Section */}
      {body && (
        <section class="max-w-5xl mx-auto px-4 md:px-8 pb-32">
          {/* Section Header - Clean Badge Style */}
          <div class="flex justify-center mb-12">
            <div class="inline-flex items-center px-6 py-2.5 bg-white rounded-full shadow-sm border border-neutral-100">
              <span class="text-sm font-medium text-neutral-700 tracking-wide">项目介绍</span>
            </div>
          </div>

          {/* Content Card - Clean & Minimal */}
          <div class="bg-white rounded-2xl shadow-sm border border-neutral-100 overflow-hidden">
            <div class="p-8 md:p-16">
              <div class="project-content">
                <div set:html={contentHtml} />
              </div>
            </div>
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<style is:global>
  .project-content {
    color: #52525b;
    line-height: 1.8;
    font-size: 1.0625rem;
  }

  .project-content p {
    margin-bottom: 2rem;
    color: #52525b;
  }

  .project-content p:last-child {
    margin-bottom: 0;
  }

  /* Clean heading styles */
  .project-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #18181b;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .project-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #27272a;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* Minimal list styles */
  .project-content ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 2rem;
  }

  .project-content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: #52525b;
  }

  .project-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 5px;
    height: 5px;
    background: #d4d4d8;
    border-radius: 50%;
  }

  .project-content strong {
    color: #18181b;
    font-weight: 600;
  }

  .project-content a {
    color: #18181b;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #d4d4d8;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .project-content a:hover {
    text-decoration-color: #18181b;
  }

  /* First paragraph - larger text */
  .project-content > p:first-of-type {
    font-size: 1.25rem;
    color: #3f3f46;
    line-height: 1.7;
    margin-bottom: 3rem;
  }

  /* Clean horizontal rule */
  .project-content hr {
    border: none;
    height: 1px;
    background: #f4f4f5;
    margin: 4rem 0;
  }

  /* Clean blockquote */
  .project-content blockquote {
    border-left: 2px solid #e4e4e7;
    padding-left: 1.5rem;
    margin: 2.5rem 0;
    color: #71717a;
    font-style: normal;
  }

  /* Clean code style */
  .project-content code {
    background: #f4f4f5;
    color: #18181b;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'SF Mono', Monaco, monospace;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .project-content {
      font-size: 1rem;
    }

    .project-content h2 {
      font-size: 1.375rem;
      margin-top: 3rem;
    }

    .project-content > p:first-of-type {
      font-size: 1.125rem;
    }
  }
</style>
